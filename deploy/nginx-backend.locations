location ^~ /backend/auth/v1/ {
    proxy_pass http://127.0.0.1:18991/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_read_timeout 30s;
}
location ^~ /backend/rest/v1/ {
    proxy_pass http://127.0.0.1:18992/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_read_timeout 30s;
}
location ^~ /backend/functions/v1/ {
    proxy_pass http://127.0.0.1:18993/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_read_timeout 155s;
}
location ^~ /backend/ { return 404; }
