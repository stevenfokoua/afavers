      "css": ".ds-button-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:36px;padding:8px 12px;border:1px solid var(--line,#e2e5e8);border-radius:3px;background:var(--surface,#fff);color:var(--ink,#181b1f);font-size:14px;font-weight:500;line-height:20px;white-space:nowrap;text-decoration:none;cursor:pointer;font-family:var(--font-ui,'DM Sans',system-ui,sans-serif);}.ds-button-secondary:hover:not(:disabled){background:var(--hover,#eef0f1);}.ds-button-secondary:focus-visible{outline:2px solid var(--accent,#067647);outline-offset:3px;}.ds-button-secondary:disabled{opacity:.5;cursor:not-allowed;}@media(max-width:767px), (pointer:coarse){.ds-button-secondary{min-height:44px;}}"
    },
