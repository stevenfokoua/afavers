  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Neutral filled primary workspace action.",
      "html": "<button type=\"button\" class=\"ds-button-primary\">Review new jobs</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:36px;padding:8px 12px;border:1px solid var(--line,#e2e5e8);border-radius:3px;background:var(--surface,#fff);color:var(--ink,#181b1f);font-size:14px;font-weight:500;line-height:20px;white-space:nowrap;text-decoration:none;cursor:pointer;font-family:var(--font-ui,'DM Sans',system-ui,sans-serif);background:var(--ink,#181b1f);color:var(--on-ink,#fff);border-color:var(--ink,#181b1f);}.ds-button-primary:hover:not(:disabled){background:var(--ink,#181b1f);filter:brightness(.9);}.ds-button-primary:focus-visible{outline:2px solid var(--accent,#067647);outline-offset:3px;}.ds-button-primary:disabled{opacity:.5;cursor:not-allowed;}@media(max-width:767px), (pointer:coarse){.ds-button-primary{min-height:44px;}}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
